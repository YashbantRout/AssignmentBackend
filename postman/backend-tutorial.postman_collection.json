        {
          "name": "4. Login User (Success - Auto Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.environment.set(\"jwtToken\", res.data.token);",
                  "    pm.collectionVariables.set(\"jwtToken\", res.data.token);",
                  "    console.log(\"Saved JWT token to environment & collection variables\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            },
            "description": "Authenticates user, returns JWT token, and saves it into jwtToken variable."
          },
          "response": [
            {
              "name": "200 OK Response",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"User logged in successfully\",\n  \"data\": {\n    \"_id\": \"65e2b0c3f5a1e2d4e8912345\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n  }\n}"
